<!--
.NET Framework 4.6.2+ 工控穩定配置。配置原則：
- 降低不確定性，而不是追求最新版本
- 優先 net462 / net472 / net48 最後穩定版本
- 不使用 .NET 8/9 runtime line
- 避免過度升級造成 runtime 衝突
- https://www.nuget.org/
-->

<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- Microsoft.Extensions（統一版本，避免分裂） -->
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Primitives" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="6.0.0" />
		<PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="6.0.1" />
		<PackageVersion Include="System.Diagnostics.Contracts" Version="4.3.0" />

		<!-- BCL -->
		<PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
		<PackageVersion Include="System.Collections.Immutable" Version="9.0.17" />

		<PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageVersion Include="System.Buffers" Version="4.6.1" />
		<PackageVersion Include="System.Memory" Version="4.6.3" />
		<PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
		<PackageVersion Include="System.Drawing.Common" Version="4.7.2" />
		<PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
		<PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
		<PackageVersion Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
		<PackageVersion Include="System.Linq.Async" Version="5.1.0" />

		<PackageVersion Include="System.Security.Permissions" Version="4.7.0" />
		<PackageVersion Include="System.Security.Principal.Windows" Version="6.0.1" />
		<PackageVersion Include="System.Security.AccessControl" Version="4.6.3" />
		<PackageVersion Include="System.DirectoryServices.Protocols" Version="8.0.2" />

		<PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.17" />
		<PackageVersion Include="System.Text.Encodings.Web" Version="8.0.0" />
		<PackageVersion Include="Microsoft.NET.StringTools" Version="17.11.4" />

		<PackageVersion Include="System.Reflection.Emit" Version="4.7.0" />
		<PackageVersion Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
		<PackageVersion Include="System.Reflection.Metadata" Version="9.0.17" />

		<!-- Extensions -->
		<PackageVersion Include="System.Resources.Extensions" Version="4.7.0" />
		<PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
		<PackageVersion Include="System.Configuration.ConfigurationManager" Version="6.0.2" />
		<PackageVersion Include="System.Runtime.Caching" Version="6.0.1" />
		<PackageVersion Include="System.ValueTuple" Version="4.6.2" />
		<PackageVersion Include="System.Formats.Asn1" Version="8.0.2" />

		<!--
			.NET Framework 4.6.2 的 System.IO.Pipelines 和 System.Threading.Channels 版本存在穩定性問題。
			如果必須在 .NET Framework 4.6.2 上使用這些套件，建議使用較舊的版本（5.x.x），但請注意仍可能會遇到穩定性問題。
			雖然 5.x.x 版本在 NuGet 上已經標示為 "已淘汰"，但目前還沒發現更好的替代方案，也暫時沒出現問題，因此先保留。
			如果公司環境允許，建議使用 .NET Framework 4.8 以獲得更好的性能和穩定性。
		-->
		<PackageVersion Include="System.IO.Pipelines" Version="6.0.3"
                		Condition="'$(TargetFramework)' == 'net472' OR '$(TargetFramework)' == 'net48'" />
		<PackageVersion Include="System.IO.Pipelines" Version="5.0.1"
						Condition="'$(TargetFramework)' == 'net462'" />
		<PackageVersion Include="System.Threading.Channels" Version="6.0.0" />

		<!--
			System.Text.Json 在 .NET Framework 不是原生設計 (它是 .NET Core 3.0 才加入標準庫)，
			所以操作 JSON 資料一律使用 Newtonsoft.Json。
			這裡保留版本設定是因為有些套件會使用它。
		-->
		<PackageVersion Include="System.Text.Json" Version="8.0.6" />

		<!-- Serialization -->
		<!--
			若有需要使用 MessagePack，比較建議 net472 以上版本使用 (相依 net472 及 .NET Standard 2.1)，
			且它引用的 Microsoft.NET.StringTools 在以前有 BUG https://github.com/MessagePack-CSharp/MessagePack-CSharp/issues/1509。
			若 net 462 要使用，建議安裝 MessagePack v2.x.x (相依 .NET Standard 2.0)，所以這裡不再列出。
		-->
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

		<!-- Dependency Injection -->
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
		<PackageVersion Include="Autofac" Version="6.5.0" />
		<PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />

		<!-- Logging -->
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="6.0.0" />
		<PackageVersion Include="Serilog.Extensions.Logging" Version="3.1.0" />
		<PackageVersion Include="Serilog" Version="2.12.0" />
		<PackageVersion Include="Serilog.Expressions" Version="3.4.1" />
		<PackageVersion Include="Serilog.Settings.Configuration" Version="3.4.0" />
		<PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />
		<PackageVersion Include="Serilog.Sinks.Console" Version="4.1.0" />
		<PackageVersion Include="Serilog.Sinks.Debug" Version="2.0.0" />
		<PackageVersion Include="Serilog.Enrichers.Environment" Version="2.2.0" />
		<PackageVersion Include="Serilog.Enrichers.Process" Version="2.0.2" />
		<PackageVersion Include="Serilog.Enrichers.Thread" Version="3.1.0" />
		<PackageVersion Include="Serilog.Formatting.Compact" Version="1.1.0" />

		<!-- Mail -->
		<PackageVersion Include="MailKit" Version="4.17.0" />
		<PackageVersion Include="MimeKit" Version="4.17.0" />

		<!-- Database / ORM -->
		<PackageVersion Include="System.ComponentModel.DataAnnotations" Version="5.0.0" />
		<PackageVersion Include="System.Data.DataSetExtensions" Version="4.5.0" />
		<PackageVersion Include="EntityFramework" Version="6.5.2" />

		<!-- SQLite 從 2.x 開始只支援 .NET Framework 4.7.1+ -->
		<PackageVersion Include="System.Data.SQLite" Version="1.0.119" />
		<PackageVersion Include="System.Data.SQLite.Core" Version="1.0.119" />
		<PackageVersion Include="System.Data.SQLite.EF6" Version="1.0.119" />
		<PackageVersion Include="System.Data.SQLite.Linq" Version="1.0.119" />
		<PackageVersion Include="Stub.System.Data.SQLite.Core.NetFramework" Version="1.0.119" />
		<PackageVersion Include="SQLite.CodeFirst" Version="1.7.0.36" />

		<!-- MVVM -->
		<PackageVersion Include="CommunityToolkit.Mvvm" Version="7.1.2" />

		<!-- Migration -->
		<PackageVersion Include="FluentMigrator" Version="3.3.2" />
		<PackageVersion Include="FluentMigrator.Abstractions" Version="3.3.2" />
		<PackageVersion Include="FluentMigrator.Runner.Core" Version="3.3.2" />
		<PackageVersion Include="FluentMigrator.Runner.SQLite" Version="3.3.2" />

		<!-- WinForms -->
		<PackageVersion Include="SunnyUI" Version="3.9.7" />
		<PackageVersion Include="SunnyUI.Common" Version="3.9.7" />

		<!-- 外部程式 -->
		<PackageVersion Include="DocumentFormat.OpenXml.Framework" Version="3.5.1" />
		<PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageVersion Include="MiniExcel" Version="1.36.1" />
		<PackageVersion Include="CsvHelper" Version="33.1.0" />
		<PackageVersion Include="ACadSharp" Version="3.6.51" />
		<PackageVersion Include="ACadSharp.Pdf" Version="0.1.5" />

		<!-- 繪圖/圖表 -->
		<PackageVersion Include="ScottPlot" Version="4.1.74" />
		<PackageVersion Include="ScottPlot.WinForms" Version="4.1.74" />
		<!--
		以下是 ScottPlot 5 的相依套件。
		但 .NET462 + Windowns 7 (GDI+) 跑起來不一定比較順，且還有機率崩潰，使用前須自行測試。
		https://github.com/ScottPlot/ScottPlot/issues/3300

		SkiaSharp (>= 4.150.1)
		SkiaSharp.HarfBuzz (>= 3.119.0)
			HarfBuzzSharp (>= 14.2.1.1)
				HarfBuzzSharp.NativeAssets.macOS (>= 14.2.1.1)
				HarfBuzzSharp.NativeAssets.Win32 (>= 14.2.1.1)
		SkiaSharp.NativeAssets.Linux.NoDependencies (>= 3.119.0)
		HarfBuzzSharp.NativeAssets.Linux (>= 8.3.1.1)
		-->

		<!-- 通訊 -->
		<PackageVersion Include="RJCP.SerialPortStream" Version="3.0.4" />
		<PackageVersion Include="RJCP.Core.Environment" Version="0.3.0" />
		<PackageVersion Include="RJCP.Core.SysCompat" Version="0.2.0" />
		<PackageVersion Include="RJCP.IO.Buffer" Version="0.2.2" />
		<PackageVersion Include="RJCP.IO.Device" Version="0.8.3" />
		<PackageVersion Include="RJCP.Diagnostics.Trace" Version="0.2.1" />
		<PackageVersion Include="HIDSharp" Version="2.6.4" />

		<!-- Finite-State Machine -->
		<PackageVersion Include="Stateless" Version="5.20.1" />

		<!-- 數值運算 -->
		<PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
		<PackageVersion Include="MathNet.Filtering" Version="0.7.0" />
		<PackageVersion Include="MathNet.Spatial" Version="0.6.0" />
		<PackageVersion Include="FftSharp" Version="2.2.0" />

		<!-- 加密/解密 -->
		<PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />

		<!-- Roslyn -->
		<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />

		<!-- MSTest -->
		<PackageVersion Include="MSTest.TestAdapter" Version="2.2.10" />
		<PackageVersion Include="MSTest.TestFramework" Version="2.2.10" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="Microsoft.CodeCoverage" Version="17.14.1" />

		<!-- BenchmarkDotNet -->
		<PackageVersion Include="BenchmarkDotNet" Version="0.13.12" />
		<PackageVersion Include="BenchmarkDotNet.Annotations" Version="0.13.12" />
		<PackageVersion Include="Gee.External.Capstone" Version="2.3.0" />
		<PackageVersion Include="Iced" Version="1.17.0" />
		<PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.251802" />
		<PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="2.2.332302" />
		<PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.0.2" />
		<PackageVersion Include="Perfolizer" Version="0.2.1" />
		<PackageVersion Include="System.Management" Version="5.0.0" />
		<PackageVersion Include="CommandLineParser" Version="2.9.1" />
		<PackageVersion Include="Microsoft.DotNet.PlatformAbstractions" Version="3.1.6" />
		<PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />

		<!-- Fody -->
		<PackageVersion Include="Fody" Version="6.9.3"/>
		<PackageVersion Include="Costura.Fody" Version="6.2.0"/>

		<!-- 佳凌科技內部套件 -->
		<PackageVersion Include="Calin" Version="0.2.5" />
		<PackageVersion Include="Calin.Diagnostics" Version="0.0.1" />
		<PackageVersion Include="Calin.Diagnostics.Sinks" Version="0.0.1" />
		<PackageVersion Include="Calin.Numerics" Version="0.0.3" />
		<PackageVersion Include="Calin.WinForms" Version="0.1.8" />
		<PackageVersion Include="Calin.Navigation" Version="0.1.4" />
		<PackageVersion Include="Calin.Navigation.WinForms" Version="0.1.0" />
		<PackageVersion Include="Calin.Coordination" Version="0.1.1" />
		<PackageVersion Include="Calin.RawInput" Version="0.0.2" />

		<PackageVersion Include="Calin.DependencyInjection" Version="0.1.2" />
		<PackageVersion Include="Calin.Logging" Version="0.1.2" />
		<PackageVersion Include="Calin.Logging.Serilog" Version="0.1.2" />

		<PackageVersion Include="Calin.Communication.IO.Abstractions" Version="0.1.2" />
		<PackageVersion Include="Calin.Communication.Transport.Core" Version="0.1.3" />
		<PackageVersion Include="Calin.Communication.SerialPort" Version="0.1.4" />
		<PackageVersion Include="Calin.Communication.Modbus" Version="0.1.4" />

		<PackageVersion Include="Calin.DAQ.USB4704" Version="0.1.1" />

		<PackageVersion Include="Calin.MotionControl.Advantech" Version="0.1.0" />
		<PackageVersion Include="Calin.MotionControl.TOYO_TC100_Modbus" Version="0.1.0" />

	</ItemGroup>
</Project>
